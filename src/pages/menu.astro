---
import Layout from "../layouts/Layout.astro";

const menu = [
  {
    section: "Small plates",
    items: [
      { name: "Whipped cod's roe", price: "£8", note: "pickled fennel, sourdough" },
      { name: "Cured trout", price: "£9", note: "horseradish cream, dill" },
      { name: "Salt-baked beetroot", price: "£7", note: "hazelnut, goat curd" },
    ],
  },
  {
    section: "Mains",
    items: [
      { name: "Dry-aged beef", price: "£24", note: "bone marrow butter, triple-cooked chips" },
      { name: "Roast cod", price: "£21", note: "brown shrimp, sea herbs" },
      { name: "Wild mushroom risotto", price: "£18", note: "aged parmesan, truffle oil" },
    ],
  },
  {
    section: "Puddings",
    items: [
      { name: "Burnt honey custard tart", price: "£8", note: "poached rhubarb" },
      { name: "Dark chocolate delice", price: "£9", note: "salted caramel, crème fraîche" },
      { name: "Selection of British cheeses", price: "£11", note: "oat biscuits, quince" },
    ],
  },
];
---

<Layout
  title="Menu — The Copper Spoon"
  description="Seasonal British plates at The Copper Spoon, Manchester."
>

  <section class="px-6 py-16 max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Menu</h1>
    <p class="text-stone-600 mb-12">
      Our menu changes with the seasons. Here's a taste of what's on right now.
    </p>

    {menu.map((group) => (
      <div class="mb-14">
        <h2 class="text-2xl font-bold mb-6">{group.section}</h2>
        <ul class="space-y-4">
          {group.items.map((item) => (
            <li class="flex justify-between gap-6 border-b border-stone-200 pb-4">
              <div>
                <p class="font-semibold">{item.name}</p>
                <p class="text-sm text-stone-500">{item.note}</p>
              </div>
              <p class="font-semibold whitespace-nowrap">{item.price}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

</Layout>
