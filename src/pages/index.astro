---
import Layout from "../layouts/Layout.astro";

const restaurant = {
  name: "The Copper Spoon",
  tagline: "Modern British bistro in the heart of Manchester",
  hours: "Tue–Sun, 12pm–10pm",
};
---

<Layout
  title="The Copper Spoon — Modern British bistro in Manchester"
  description="Seasonal British plates and natural wine in Manchester's Northern Quarter."
>

  <section class="px-6 py-24 max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight">
      {restaurant.tagline}
    </h1>
    <p class="mt-6 text-lg text-stone-600 max-w-xl mx-auto">
      Seasonal plates, natural wine, and a warm room. Open {restaurant.hours}.
    </p>
    <div class="mt-10 flex gap-4 justify-center flex-wrap">
      <a href="/contact" class="bg-amber-700 text-white px-6 py-3 rounded-full hover:bg-amber-800">
        Book a table
      </a>
      <a href="/menu" class="border border-stone-300 px-6 py-3 rounded-full hover:border-stone-500">
        See the menu
      </a>
    </div>
  </section>

  <section class="px-6 py-20 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-10">A taste of the menu</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="border border-stone-200 p-6 rounded-lg">
          <h3 class="font-semibold text-lg">Small plates</h3>
          <p class="text-sm text-stone-600 mt-2">Whipped cod's roe, pickled fennel, sourdough.</p>
        </div>
        <div class="border border-stone-200 p-6 rounded-lg">
          <h3 class="font-semibold text-lg">Mains</h3>
          <p class="text-sm text-stone-600 mt-2">Dry-aged beef, bone marrow butter, triple-cooked chips.</p>
        </div>
        <div class="border border-stone-200 p-6 rounded-lg">
          <h3 class="font-semibold text-lg">Puddings</h3>
          <p class="text-sm text-stone-600 mt-2">Burnt honey custard tart, poached rhubarb.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 py-20 max-w-3xl mx-auto text-center">
    <p class="text-xl md:text-2xl italic text-stone-700">
      "The best meal we've had in Manchester this year."
    </p>
    <p class="mt-4 text-sm text-stone-500">— Sarah M., Google review</p>
  </section>

</Layout>
