---
// FRONTMATTER — this runs before the page is built.
// Later, this is where data will come from the CMS.
// For now, it's just typed in directly.
const restaurant = {
  name: "The Copper Spoon",
  tagline: "Modern British bistro in the heart of Manchester",
  phone: "0161 123 4567",
  address: "42 Tib Street, Manchester M4 1LG",
  hours: "Tue–Sun, 12pm–10pm",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{restaurant.name} — {restaurant.tagline}</title>
    <meta
      name="description"
      content="Seasonal British plates and natural wine in Manchester's Northern Quarter."
    />
  </head>

  <body class="bg-stone-50 text-stone-900 font-sans">

    <!-- NAVIGATION -->
    <nav class="flex items-center justify-between px-6 py-5 max-w-6xl mx-auto">
      <span class="font-bold text-xl">{restaurant.name}</span>

      <div class="hidden md:flex gap-8 text-sm">
        <a href="/" class="hover:text-amber-700">Home</a>
        <a href="/menu" class="hover:text-amber-700">Menu</a>
        <a href="/about" class="hover:text-amber-700">About</a>
        <a href="/contact" class="hover:text-amber-700">Contact</a>
      </div>

      <a
        href="/contact"
        class="bg-amber-700 text-white px-5 py-2 rounded-full text-sm hover:bg-amber-800"
      >
        Book a table
      </a>
    </nav>

    <!-- HERO -->
    <section class="px-6 py-24 max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight">
        {restaurant.tagline}
      </h1>
      <p class="mt-6 text-lg text-stone-600 max-w-xl mx-auto">
        Seasonal plates, natural wine, and a warm room. Open {restaurant.hours}.
      </p>
      <div class="mt-10 flex gap-4 justify-center flex-wrap">
        <a
          href="/contact"
          class="bg-amber-700 text-white px-6 py-3 rounded-full hover:bg-amber-800"
        >
          Book a table
        </a>
        <a
          href="/menu"
          class="border border-stone-300 px-6 py-3 rounded-full hover:border-stone-500"
        >
          See the menu
        </a>
      </div>
    </section>

    <!-- MENU HIGHLIGHTS -->
    <section class="px-6 py-20 bg-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-10">A taste of the menu</h2>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="border border-stone-200 p-6 rounded-lg">
            <h3 class="font-semibold text-lg">Small plates</h3>
            <p class="text-sm text-stone-600 mt-2">
              Whipped cod's roe, pickled fennel, sourdough.
            </p>
          </div>

          <div class="border border-stone-200 p-6 rounded-lg">
            <h3 class="font-semibold text-lg">Mains</h3>
            <p class="text-sm text-stone-600 mt-2">
              Dry-aged beef, bone marrow butter, triple-cooked chips.
            </p>
          </div>

          <div class="border border-stone-200 p-6 rounded-lg">
            <h3 class="font-semibold text-lg">Puddings</h3>
            <p class="text-sm text-stone-600 mt-2">
              Burnt honey custard tart, poached rhubarb.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section class="px-6 py-20 max-w-3xl mx-auto text-center">
      <p class="text-xl md:text-2xl italic text-stone-700">
        "The best meal we've had in Manchester this year. Warm, unfussy, and
        every plate was spot on."
      </p>
      <p class="mt-4 text-sm text-stone-500">— Sarah M., Google review</p>
    </section>

    <!-- FOOTER -->
    <footer class="px-6 py-12 bg-stone-900 text-stone-300">
      <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8 text-sm">
        <div>
          <p class="font-semibold text-white mb-2">{restaurant.name}</p>
          <p>{restaurant.address}</p>
        </div>
        <div>
          <p class="font-semibold text-white mb-2">Hours</p>
          <p>{restaurant.hours}</p>
        </div>
        <div>
          <p class="font-semibold text-white mb-2">Contact</p>
          <p>{restaurant.phone}</p>
        </div>
      </div>
    </footer>

  </body>
</html>
